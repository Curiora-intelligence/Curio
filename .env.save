# Curio local MLX settings. No API keys required.
CURIO_MLX_TEXT_MODEL="/Users/saiganeshsattenapalli/.cache/huggingface/hub/models--mlx-community--gpt-oss-20b-MXFP4-Q8/snapshots/773a7da77e569019bb0fd17a554b263738d669a3"
CURIO_MLX_VISION_MODEL="/Users/saiganeshsattenapalli/.cache/huggingface/hub/models--mlx-community--Qwen3-VL-8B-Instruct-8bit/snapshots/a0093b9b5fda6f76ddd4a462c6830ae7c4fe47ec"
CURIO_MAX_TEXT_TOKENS=12000
CURIO_MAX_VISION_TOKENS=10000
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
DATABASE_URL=postgresql+asyncpg://localhost/curio
# Redis is optional and disposable.
REDIS_URL=redis://localhost:6379/0
CURIO_BROWSER_BACKEND=ddgs

EXA_API_KEY=
CURIO_FRAME_INTERVAL=5
CURIO_MAX_TEXT_TOKENS=1024
CURIO_MAX_VISION_TOKENS=384
# Existing local snapshots, or model IDs (may download if not cached).
CURIO_MLX_TEXT_MODEL=
CURIO_MLX_VISION_MODEL=
# Optional: an already downloaded SentenceTransformer directory (CPU only).
CURIO_EMBEDDING_MODEL=
# Small prompt chunks reduce peak MLX memory for tool schemas and retrieved context.
CURIO_MLX_PREFILL_STEP_SIZE=128

# First-party browser origins allowed to use HTTP/SSE.
CURIO_FRONTEND_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
